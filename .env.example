# ============================================
# DATABASE (Neon PostgreSQL)
# ============================================
# Pooled connection string (recommended for serverless queries)
DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require"

# Direct unpooled connection string (recommended for Prisma migrations)
DIRECT_URL="postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[dbname]?sslmode=require"

# ============================================
# AUTHENTICATION (NextAuth v5)
# ============================================
AUTH_SECRET="your-nextauth-secret-key-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth Provider
GITHUB_ID=""
GITHUB_SECRET=""

