# ============================================
# DATABASE (Neon PostgreSQL)
# ============================================
# Pooled connection string (recommended for serverless queries)
DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require"

# Direct unpooled connection string (recommended for Prisma migrations)
DIRECT_URL="postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[dbname]?sslmode=require"

# ============================================
# AUTHENTICATION (NextAuth v5)
# ============================================
AUTH_SECRET="your-nextauth-secret-key-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth Provider (NextAuth v5)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ============================================
# EMAIL & RESEND
# ============================================
# Resend API Key for sending transactional emails (e.g. email verification)
RESEND_API_KEY=""
EMAIL_FROM="DevStash <onboarding@resend.dev>"

# Set to "true" to enforce email verification upon user registration.
# Set to "false" (or leave empty) to auto-verify users upon registration (useful when running locally without a verified Resend domain).
ENABLE_EMAIL_VERIFICATION="false"

# ============================================
# RATE LIMITING (Upstash Redis)
# ============================================
# Upstash Redis REST API credentials for serverless rate limiting.
# If omitted or invalid, rate limiting safely fails open (allows requests).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

